<Project Sdk="Microsoft.NET.Sdk">
    <!-- Browser (wasm) host; requires `dotnet workload install wasm-tools`. Publish from the project root:
         dotnet publish CuriousContraptions.web -> AppBundle/ (engine linked in, content exported as godot.pck) -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <!-- Keep host namespaces uniform with the desktop host (whose
             '.2dog' assembly name is not a valid namespace). -->
        <RootNamespace>CuriousContraptions.Web</RootNamespace>
    </PropertyGroup>
    <!-- Godot project location: the parent directory (hosts are nested inside
         the Godot project, hidden from the Godot editor by their .gdignore) -->
    <PropertyGroup>
        <GodotProjectDir>..</GodotProjectDir>
        <TwoDogRemoveDuplicateGodotAnalyzers>true</TwoDogRemoveDuplicateGodotAnalyzers>
    </PropertyGroup>

    <ItemGroup>
        <!-- TwoDogWebBoot.cs is compiled by the GAME project (see the root
             csproj's Compile Include), not by this host. -->
        <Compile Remove="TwoDogWebBoot.cs"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="2dog.engine" Version="$(TwoDogVersion)"/>
        <PackageReference Include="2dog.browser-wasm" Version="[$(TwoDogNativesVersion)]"/>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../CuriousContraptions.csproj"/>
    </ItemGroup>

    <!-- Scripts are resolved by reflection: root the game assembly, and any NuGet package your game reaches
         via reflection (e.g. an ECS or serializer library) -->
    <ItemGroup>
        <TrimmerRootAssembly Include="CuriousContraptions"/>
        <TrimmerRootAssembly Include="$(TargetName)"/>
    </ItemGroup>

    <!-- Godot's editor serializes exported C# properties using the native Debug metadata.
         Keep that real project output current before import/export and in their incremental inputs. -->
    <Target Name="BuildWorkshopEditorMetadata"
            BeforeTargets="TwoDogImportGodotProject;TwoDogExportGamePack"
            Condition="'$(DesignTimeBuild)' != 'true'">
        <MSBuild Projects="../CuriousContraptions.csproj" Targets="Restore;Build"
                 Properties="Configuration=Debug" RemoveProperties="RuntimeIdentifier;SelfContained">
            <Output TaskParameter="TargetOutputs" ItemName="_WorkshopEditorMetadata" />
        </MSBuild>
        <Error Condition="'@(_WorkshopEditorMetadata)' == ''" Text="Current game editor metadata output is required for resource export." />
        <ItemGroup>
            <TwoDogImportInputs Include="@(_WorkshopEditorMetadata)" />
            <TwoDogWebExportInputs Include="@(_WorkshopEditorMetadata)" />
            <TwoDogWebExportInputs Include="$(IntermediateOutputPath)workshop-editor-metadata.stamp" />
        </ItemGroup>
    </Target>

    <!-- Godot's binary conversion cache keys resource text, but omits C# property metadata.
         Retire only these generated conversion outputs when the actual editor assembly changes. -->
    <Target Name="InvalidateWorkshopResourceMetadata"
            BeforeTargets="TwoDogExportGamePack"
            DependsOnTargets="BuildWorkshopEditorMetadata"
            Inputs="@(_WorkshopEditorMetadata)"
            Outputs="$(IntermediateOutputPath)workshop-editor-metadata.stamp">
        <RemoveDir Directories="$(TwoDogGodotProjectFullPath)/.godot/exported" />
        <Touch Files="$(IntermediateOutputPath)workshop-editor-metadata.stamp" AlwaysCreate="true" />
        <ItemGroup>
            <FileWrites Include="$(IntermediateOutputPath)workshop-editor-metadata.stamp" />
        </ItemGroup>
    </Target>

    <!-- Build the independent numerical worker normally; a failed worker export fails the host bundle. -->
    <Target Name="BuildWorkshopWorker" BeforeTargets="_WasmGenerateAppBundle">
        <MSBuild Projects="../CuriousContraptions.Simulation/CuriousContraptions.Simulation.csproj"
                 Targets="Restore" Properties="Configuration=$(Configuration)"
                 RemoveProperties="_IsPublishing;_WasmIsPublishing;DeployOnBuild;WasmBuildingForNestedPublish;_WasmInNestedPublish_UniqueProperty_XYZ;WasmBuildOnlyAfterPublish" />
        <MSBuild Projects="../CuriousContraptions.Simulation/CuriousContraptions.Simulation.csproj"
                 Targets="GetWorkshopWorkerBundle" Properties="Configuration=$(Configuration)"
                 RemoveProperties="_IsPublishing;_WasmIsPublishing;DeployOnBuild;WasmBuildingForNestedPublish;_WasmInNestedPublish_UniqueProperty_XYZ;WasmBuildOnlyAfterPublish">
            <Output TaskParameter="TargetOutputs" ItemName="_WorkshopWorkerBundle" />
        </MSBuild>
    </Target>
    <Target Name="CopyWorkshopWorker" AfterTargets="_WasmGenerateAppBundle" DependsOnTargets="BuildWorkshopWorker">
        <Error Condition="'@(_WorkshopWorkerBundle)' == ''" Text="Workshop simulation worker bundle is missing." />
        <Copy SourceFiles="@(_WorkshopWorkerBundle)"
              DestinationFiles="@(_WorkshopWorkerBundle->'$(WasmAppDir)/simulation/%(BundleRelativePath)')" />
    </Target>
    <Target Name="BuildWorkshopAnimation" BeforeTargets="_WasmGenerateAppBundle">
        <MSBuild Projects="../CuriousContraptions.Animation.Worker/CuriousContraptions.Animation.Worker.csproj"
                 Targets="Restore" Properties="Configuration=$(Configuration)"
                 RemoveProperties="_IsPublishing;_WasmIsPublishing;DeployOnBuild;WasmBuildingForNestedPublish;_WasmInNestedPublish_UniqueProperty_XYZ;WasmBuildOnlyAfterPublish" />
        <MSBuild Projects="../CuriousContraptions.Animation.Worker/CuriousContraptions.Animation.Worker.csproj"
                 Targets="GetWorkshopAnimationBundle" Properties="Configuration=$(Configuration)"
                 RemoveProperties="_IsPublishing;_WasmIsPublishing;DeployOnBuild;WasmBuildingForNestedPublish;_WasmInNestedPublish_UniqueProperty_XYZ;WasmBuildOnlyAfterPublish">
            <Output TaskParameter="TargetOutputs" ItemName="_WorkshopAnimationBundle" />
        </MSBuild>
    </Target>
    <Target Name="CopyWorkshopAnimation" AfterTargets="_WasmGenerateAppBundle" DependsOnTargets="BuildWorkshopAnimation">
        <Error Condition="'@(_WorkshopAnimationBundle)' == ''" Text="Workshop Animation worker bundle is missing." />
        <Copy SourceFiles="@(_WorkshopAnimationBundle)"
              DestinationFiles="@(_WorkshopAnimationBundle->'$(WasmAppDir)/animation/%(BundleRelativePath)')" />
    </Target>
    <Target Name="DeepClean" AfterTargets="Clean">
        <RemoveDir Directories="AppBundle"/>
    </Target>
</Project>
