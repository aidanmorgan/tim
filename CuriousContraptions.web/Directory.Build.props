<Project>
    <!-- Keep the nearest Directory.Build.props above in effect (this file
         would otherwise shadow it). -->
    <PropertyGroup>
        <_TwoDogParentProps>$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))</_TwoDogParentProps>
    </PropertyGroup>
    <Import Project="$(_TwoDogParentProps)" Condition="'$(_TwoDogParentProps)' != ''"/>
    <!-- Browser bundles are only useful optimized: default to Release. A Debug publish is unsupported: the Workshop workers
         are Mono AOT-compiled (Story 9R.0b), which the WebAssembly SDK refuses in Debug. Must be set
         this early - the SDK derives DEBUG/Optimize from Configuration before the csproj body is read -->
    <PropertyGroup>
        <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    </PropertyGroup>
</Project>
