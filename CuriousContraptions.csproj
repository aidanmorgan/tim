<Project Sdk="Godot.NET.Sdk/4.7.2">
    <ItemGroup>
    <EmbeddedResource Include="content/puzzles.json" LogicalName="CuriousContraptions.Puzzles.json" /></ItemGroup>
    <ItemGroup><InternalsVisibleTo Include="CuriousContraptions.tests" /></ItemGroup>
    <PropertyGroup>
        <Nullable>enable</Nullable>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <TargetFramework>net10.0</TargetFramework>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <IsTrimmable>true</IsTrimmable>
        <VerifyReferenceTrimCompatibility>true</VerifyReferenceTrimCompatibility>
        <!-- TwoDogWebBoot.cs (web hosts) takes a function pointer to the source-generated plugins initializer;
             harmless on desktop -->
        <DefineConstants>$(DefineConstants);TWODOG_WEB_BOOT</DefineConstants>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <DefineConstants Condition="'$(PlaytestDiagnostics)' == 'true'">$(DefineConstants);PLAYTEST</DefineConstants>
        <!-- Keep nested host projects out of the default compile/content globs (their .gdignore hides them
             from the Godot editor) -->
        <DefaultItemExcludes>$(DefaultItemExcludes);CuriousContraptions.2dog/**;CuriousContraptions.web/**;CuriousContraptions.Simulation/**;CuriousContraptions.Animation/**;CuriousContraptions.Animation.Worker/**;CuriousContraptions.FlatBuffers/**;CuriousContraptions.Bundle/**;CuriousContraptions.tests/**</DefaultItemExcludes>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="2dog.godotsharp" Version="$(TwoDogVersion)" />
        <PackageReference Include="2dog.godotsharp.editor" Version="$(TwoDogVersion)" Condition="'$(Configuration)' == 'Debug' Or '$(Configuration)' == 'Editor'" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="CuriousContraptions.FlatBuffers/CuriousContraptions.FlatBuffers.csproj" />
        <ProjectReference Include="CuriousContraptions.Animation/CuriousContraptions.Animation.csproj" />
        <ProjectReference Include="CuriousContraptions.Abstractions/CuriousContraptions.Abstractions.csproj" />
        <!-- Story 9A.14: the element bundle schema; the registry loads only the generated bundle. -->
        <ProjectReference Include="CuriousContraptions.Bundle/CuriousContraptions.Bundle.csproj" />
    </ItemGroup>
    <!-- Explicit current admitted game sources; diagnostic host additions are selected by their host project. -->
    <ItemGroup>
        <Compile Include="engine/gpu/*.cs" />
        <Compile Include="engine/MachineWorld.cs" />
        <Compile Include="engine/MachineWorld.Gpu.cs" />
        <Compile Include="engine/MachinePart.cs" />
        <Compile Include="engine/WorkshopVisualBinding.cs" />
        <Compile Include="engine/CosmeticBindingSet.cs" />
        <Compile Include="engine/WorkshopUiBinding.cs" />
        <Compile Include="engine/PartDefinition.cs" />
        <Compile Include="engine/PartRegistry.cs" />
        <Compile Include="engine/PartId.cs" />
        <Compile Include="engine/TubeMouthSnap.cs" />
        <Compile Include="engine/Workbench.cs" />
        <Compile Include="engine/IResizablePart.cs" />
        <Compile Include="ui/Workshop.cs" />
        <Compile Include="ui/WorkshopUiFailure.cs" />
        <Compile Include="ui/WorkshopGpu.cs" />
        <Compile Include="ui/WorkshopConnections.cs" />
        <Compile Include="ui/WorkshopConfiguration.cs" />
        <Compile Include="ui/WorkshopPuzzle.cs" />
        <Compile Include="ui/WorkshopGuidance.cs" />
        <Compile Include="ui/WorkshopAnimation.cs" />
        <Compile Include="ui/WorkshopIcons.cs" />
        <Compile Include="ui/RotationGizmo.cs" />
        <Compile Include="ui/PlacementShadows.cs" />
        <Compile Include="ui/WorkshopArtwork.cs" />
        <Compile Include="ui/WorkshopBenchPlacement.cs" />
        <Compile Include="CuriousContraptions.web/TwoDogWebBoot.cs" />
    </ItemGroup>
</Project>
