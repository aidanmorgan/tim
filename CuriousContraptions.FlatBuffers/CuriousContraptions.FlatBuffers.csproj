<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Google FlatBuffers C# runtime, vendored from google/flatbuffers tag v25.2.10 (net/FlatBuffers,
       Apache-2.0, see LICENSE) so the one wire codec is built trim-annotated: the published Google.FlatBuffers
       package is not, which made every trimmable consumer report IL2125 (Story 9.4b). The wire accessors are build
       output: every build that finds them absent or older than the one schema file, schemas/workshop_wire.fbs,
       either shared compiler import or this file generates them into this project's intermediate directory with
       the compiler provisioned by tools/runtime/FlatcCompiler.targets, whose output asserts this exact runtime version
       (FLATBUFFERS_25_2_10). Upgrade by replacing every source file from a newer tag together with the compiler version
       and its digests in tools/runtime/FlatcCompiler.targets. The bounded vtable offset corrections (Story 9A.45), the
       verifier's unknown-field rule (S5c) and their exact integrity pins are documented in THIRD-PARTY-NOTICES.md; an
       upgrade re-applies both patches, and the direct verifier tests fail if one is dropped. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CuriousContraptions.FlatBuffers</AssemblyName>
    <RootNamespace>Google.FlatBuffers</RootNamespace>
    <IsTrimmable>true</IsTrimmable>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <WireSchema Include="$(WireSchemaPath)" />
  </ItemGroup>

  <!-- Generates one C# source per schema type into WireAccessors/ under the intermediate directory, replacing the previous
       output, whenever the stamp is absent or older than the schema, either shared compiler import or this project file.
       A clean tree or a no-incremental build has no stamp. ProvisionFlatBuffersCompiler is imported through
       Directory.Build.targets -> RuntimeTypeScript.targets -> FlatcCompiler.targets. -->
  <Target Name="GenerateWireAccessors" DependsOnTargets="ValidateWireAccessorOutput"
          Inputs="@(WireSchema);$(MSBuildProjectFullPath);$(_FlatcCompilerTargets);$(_WireTypeScriptTargets)" Outputs="$(_WireAccessorStamp);@(_WireCSharpSource)">
    <CallTarget Targets="ProvisionFlatBuffersCompiler" />
    <RemoveDir Directories="$(_WireAccessorDirectory)" />
    <Exec Command="'$(_FlatcShellExecutable)' --csharp -o '$(_WireShellAccessorDirectory)' '$(_FlatcShellSchema)'" />
    <Touch Files="$(_WireAccessorStamp)" AlwaysCreate="true" />
  </Target>

  <!-- The nullable ArraySegment byte accessors are the only wire surface. The generated sources also carry ENABLE_SPAN_T
       alternatives, so every build refuses that define, wherever it stands in a list separated by ';', ',' or whitespace
       as the compiler splits it, before anything is generated or compiled. -->
  <Target Name="RefuseSpanAccessorDefine">
    <Error Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(DefineConstants)', '(^|[;,\s])ENABLE_SPAN_T($|[;,\s])'))"
           Text="CuriousContraptions.FlatBuffers is built with ENABLE_SPAN_T in DefineConstants ($(DefineConstants)). The nullable ArraySegment accessors are the only wire surface, so the generated Span accessors are never compiled; remove the define." />
  </Target>

  <!-- Every build compiles the generated sources and records them as its own outputs, so Clean and Rebuild remove them. -->
  <Target Name="CompileWireAccessors" BeforeTargets="BeforeCompile" DependsOnTargets="RefuseSpanAccessorDefine;GenerateWireAccessors">
    <ItemGroup>
      <Compile Include="@(_WireCSharpSource)" />
      <!-- Use SDK path identities for Clean bookkeeping, including when the checkout has a filesystem alias. -->
      <FileWrites Include="$(_WireAccessorPath)**/*.cs;$(_WireAccessorPath).generated" />
    </ItemGroup>
  </Target>
</Project>
