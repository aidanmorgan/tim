  "productionStartupRecipe": "async (page) => {\n const context=await page.context().browser().newContext();\n const tab=await context.newPage(),errors=[],banners=[];\n tab.on(\"console\",message=>{\n   const value=message.text();\n   if(message.type()===\"error\") errors.push(value);\n   if(value.includes(\"Godot Engine\")) banners.push(value);\n });\n tab.on(\"pageerror\",error=>errors.push(error.message));\n try{\n   await tab.goto(\"http://127.0.0.1:8060\");\n   const deadline=Date.now()+30000;\n   while(!banners.length&&Date.now()<deadline) await tab.waitForTimeout(100);\n   await tab.waitForTimeout(1000);\n   const canvasVisible=await tab.locator(\"canvas\").first().isVisible();\n   if(!banners.length||!canvasVisible||errors.length) throw Error(JSON.stringify({banners,canvasVisible,errors}));\n   return {banners,canvasVisible,errors,scope:\"Production Release startup smoke only; not gameplay behaviour proof.\"};\n }finally{await context.close();}\n}",
