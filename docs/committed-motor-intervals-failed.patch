+        foreach(var kind in new[]{FrameJointKind.Slider,FrameJointKind.Hinge})
+        foreach(var sign in new[]{-1,1})
+        foreach(var ratio in new[]{-2d,1d,2d})
+        foreach(var engagement in Enum.GetValues<TransmissionEngagement>())
