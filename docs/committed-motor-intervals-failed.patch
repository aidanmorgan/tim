+        Near(-1,prediction.Trajectories[body.Id].LinearVelocityAt(1).Z);
+        Near(1,use.Work.Supplied);Near(4,use.Work.Dissipated);
+        Assert.True(use.Work.Supplied+use.Work.SuppliedErrorBound<=1);
