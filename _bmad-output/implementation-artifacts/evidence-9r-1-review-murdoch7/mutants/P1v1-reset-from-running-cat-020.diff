+    // Murdoch-7 probe: Reset pressed while Running (no Pause), at two points of the run. Non-vacuity: the pose ring shows the
+    // world advanced (publications and a moved body) before the Reset; the Reset is then the player's Space-while-Running path.
+    async function probeResetFromRunning(s0: RunResetSnapshot, holdMs: number, label: string): Promise<RunResetSnapshot> {
+        const before = await driver.readLatestPose();
+        assert.ok(before, `${label}: Build pose readable`);
+        await driver.run(holdMs);
+        const during = await driver.readLatestPose();
+        assert.ok(during && during.sequence !== before.sequence, `${label}: the pose ring advanced while Running`);
+        const moved = during.bodies.some(body => {
+            const start = before.bodies.find(candidate => candidate.id === body.id);
+            return start !== undefined && Math.hypot(body.px - start.px, body.py - start.py) > 0.01;
+        });
+        assert.ok(moved, `${label}: a body moved before the Reset`);
+        console.log(`PROBE ${label}: Reset from Running after ${holdMs} ms, pose sequence ${before.sequence} -> ${during.sequence}`);
+        await driver.reset();
+        return driver.expectResetMatches(s0);
+    }
+
+    test('PROBE Murdoch-7: Reset from Running mid-count restores S0 exactly, twice', { timeout: 150000 }, async () => {
+        const s0 = await buildCounterBench(TWO_CROSSING_LIFTS);
+        assertCounterCleared(await probeResetFromRunning(s0, 1500, 'probe cycle 1 (1500 ms)'));
+        assertCounterCleared(await probeResetFromRunning(s0, 800, 'probe cycle 2 (800 ms)'));
+        assert.equal(errors.length, 0, `Zero errors expected, got: ${errors.join('; ')}`);
+    });
+
