+    [InlineData(DistanceFeature.Side, .00001f, true)]
+    [InlineData(DistanceFeature.Cap, -.00001f, true)]
+    [InlineData(DistanceFeature.Cap, .00001f, true)]
+    [InlineData(DistanceFeature.Rim, -.00001f, true)]
+    [InlineData(DistanceFeature.Rim, .00001f, true)]
+    public void TinyCylinderFeatureGapsKeepTheirGeometricDirection(DistanceFeature feature, float gap, bool transformed)
+    {
+        var turn = transformed ? new Quaternion(.5f, .5f, .5f, .5f) : Quaternion.Identity;
+        var offset = transformed ? new Vector3(1, -1, .5f) : Vector3.Zero;
+        var half = new Vector3(.01f);
+        var diagonal = gap / MathF.Sqrt(2);
+        var centre = feature switch
+        {
+            DistanceFeature.Side => new Vector3(.31f + gap, 0, 0),
+            DistanceFeature.Cap => new Vector3(.05f, .21f + gap, 0),
+            DistanceFeature.Rim => new Vector3(.3f + diagonal, .2f + diagonal + .01f * MathF.Sqrt(2), 0),
+            _ => throw new ArgumentOutOfRangeException(nameof(feature))
+        };
+        var localTurn = feature == DistanceFeature.Rim ? AboutZ(45) : Quaternion.Identity;
+        var cylinder = Collider(ShapeKind.Cylinder, offset, turn, .3f, .2f);
+        var box = Collider(ShapeKind.Box, offset + Vector3.Transform(centre, turn),
+            Quaternion.Multiply(turn, localTurn), 0, half, 1);
+        var points = Contacts(cylinder, box);
+        Assert.NotEmpty(points);
+        var direction = feature switch
+        {
+            DistanceFeature.Side => -Vector3.UnitX,
+            DistanceFeature.Cap => -Vector3.UnitY,
+            DistanceFeature.Rim => Vector3.Normalize(new Vector3(-1, -1, 0)),
+            _ => throw new ArgumentOutOfRangeException(nameof(feature))
+        };
+        direction = Vector3.Transform(direction, turn);
+        foreach (var point in points)
+        {
+            // A rigid transform is exact for these binary axes. Sixteen f32
+            // roundings at the 1 m translation scale fit below 2 micrometres.
+            if (feature != DistanceFeature.Rim || gap > 0)
+                Assert.InRange(point.Gap, gap - .000002f, gap + .000002f);
+            else
+                Assert.InRange(point.Gap, -.0005f, 0); // unchanged shallow-core overlap envelope
+            Assert.InRange(point.Normal.Length(), .99999f, 1.00001f);
+            Assert.True(Vector3.Dot(point.Normal, direction) > (gap > 0 ? .98f : .6f));
+        }
+    }
+
