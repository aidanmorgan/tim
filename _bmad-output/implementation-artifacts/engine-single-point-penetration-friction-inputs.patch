+    [Theory]
+    [InlineData(false)]
+    [InlineData(true)]
+    public void ATrulyTiltedCylinderKeepsItsSingleLowEdgeContact(bool reverse)
+    {
+        var axis = reverse ? new Quaternion(.5f, -.5f, .5f, -.5f) : new Quaternion(.5f, .5f, .5f, .5f);
+        var rotation = Quaternion.Multiply(Quaternion.CreateFromAxisAngle(Vector3.UnitX, .1f), axis);
+        var body = new SimBody { Px = 1.001f, Py = .3f * MathF.Cos(.1f) + .2f * MathF.Sin(.1f),
+            Qx = rotation.X, Qy = rotation.Y, Qz = rotation.Z, Qw = rotation.W };
+        var cylinder = new SimCollider { Body = body, Shape = ShapeKind.Cylinder, Radius = .3f, Hy = .2f, Rq = Quaternion.Identity };
+        WorkshopCollisionKernels.RefreshCollider(cylinder);
+        var box = new SimCollider { Body = new SimBody { Py = -.5f, Qw = 1 }, Shape = ShapeKind.Box,
+            Hx = 1, Hy = .5f, Hz = 1, Rq = Quaternion.Identity };
+        WorkshopCollisionKernels.RefreshCollider(box);
+        var points = new List<ContactPoint>();
+        WorkshopCollisionKernels.GenerateManifold(cylinder, box, .004f, points);
+        Assert.NotEmpty(points);
+        // The high end is 2h*sin(.1) = 39.9 mm clear, far beyond the 4 mm margin.
+        // Every retained point must therefore belong to the low (+Z) end.
+        Assert.All(points, point => Assert.True(point.Pz > .1f));
+    }
