; Curious Contraptions — Godot 4.7
config_version=5

[application]
config/name="Curious Contraptions"
run/main_scene="res://scenes/workshop.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.04, 0.06, 0.09, 1)
anti_aliasing/quality/msaa_3d=2

[gui]
timers/tooltip_delay_sec=1.2

[physics]
common/physics_ticks_per_second=120


[dotnet]

project/assembly_name="CuriousContraptions"
