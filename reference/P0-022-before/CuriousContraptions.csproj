<Project Sdk="Godot.NET.Sdk/4.7.2">
    <ItemGroup><InternalsVisibleTo Include="CuriousContraptions.tests" /></ItemGroup>
    <PropertyGroup>
        <Nullable>enable</Nullable>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <TargetFramework>net10.0</TargetFramework>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <IsTrimmable>true</IsTrimmable>
        <VerifyReferenceTrimCompatibility>true</VerifyReferenceTrimCompatibility>
        <!-- TwoDogWebBoot.cs (web hosts) takes a function pointer to the source-generated plugins initializer;
             harmless on desktop -->
        <DefineConstants>$(DefineConstants);TWODOG_WEB_BOOT</DefineConstants>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <DefineConstants Condition="'$(PlaytestDiagnostics)' == 'true'">$(DefineConstants);PLAYTEST</DefineConstants>
        <!-- Keep nested host projects out of the default compile/content globs (their .gdignore hides them
             from the Godot editor) -->
        <DefaultItemExcludes>$(DefaultItemExcludes);CuriousContraptions.2dog/**;CuriousContraptions.web/**;CuriousContraptions.Simulation/**;CuriousContraptions.tests/**</DefaultItemExcludes>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="2dog.godotsharp" Version="$(TwoDogVersion)" />
        <PackageReference Include="2dog.godotsharp.editor" Version="$(TwoDogVersion)"
                          Condition="'$(Configuration)' == 'Debug' Or '$(Configuration)' == 'Editor'" />
    </ItemGroup>
    <!-- One fixed admitted game build. All other engine/part source remains unshipped reference. -->
    <ItemGroup>
        <Compile Include="engine/gpu/*.cs" />
        <Compile Include="engine/MachineWorld.cs" />
        <Compile Include="engine/MachineWorld.Gpu.cs" />
        <Compile Include="engine/MachinePart.cs" />
        <Compile Include="engine/PartDefinition.cs" />
        <Compile Include="engine/BasketballMaterialResource.cs" />
        <Compile Include="engine/PartRegistry.cs" />
        <Compile Include="engine/PartArt.cs" />
        <Compile Include="engine/Workbench.cs" />
        <Compile Include="engine/IResizablePart.cs" />
        <Compile Include="parts/BallPart.cs" />
        <Compile Include="ui/Workshop.cs" />
        <Compile Include="ui/WorkshopGpu.cs" />
        <Compile Include="ui/WorkshopGuidance.cs" />
        <Compile Include="ui/WorkshopAnimation.cs" />
        <Compile Include="ui/WorkshopIcons.cs" />
        <Compile Include="ui/RotationGizmo.cs" />
        <Compile Include="ui/PlacementShadows.cs" />
        <Compile Include="CuriousContraptions.web/TwoDogWebBoot.cs" />
    </ItemGroup>
</Project>
