[ext_resource type="PackedScene" path="res://parts/scenes/linear_pusher.tscn" id="2"]
[resource]
script = ExtResource("1")
Id = "linear_pusher"
Title = "Linear pusher"
Category = "Power"
Description = "Supply the bottom socket, then power either extend or retract. Both commands brake the rod; losing supply holds its position. The cream head pushes with limited force and stops at obstacles. Upper end switches pass the independent supply only at the matching end. Ideal self-locking electric servo, not pneumatic pressure or battery depletion."
Scene = ExtResource("2")
Color = Color(0.4, 0.72, 0.79, 1)
Parameters = {"stroke": 2.4, "speed": 1.5, "acceleration": 12.0, "force": 40.0}
