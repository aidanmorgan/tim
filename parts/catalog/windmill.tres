[resource]
script = ExtResource("1")
Id = "windmill"
Title = "Windmill"
Category = "Power"
Description = "Aim airflow through the rotor, then belt its side pulley to a conveyor or reverse transmission. Backwards wind reverses the shaft; edge-on wind cannot drive it. Obstructions reduce the exposed rotor area. Coasts briefly when wind stops. Uses the current ideal-speed mechanical model, not torque or load conservation."
