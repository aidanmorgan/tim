[resource]
script = ExtResource("1")
Id = "hold_timer"
Title = "Hold timer"
Category = "Control"
Description = "An activation closes this electrical contact for two seconds. Connect a battery to its input: the timer does not create power. Busy triggers are ignored; it rearms when time is up."
Scene = ExtResource("2")
Color = Color(0.40, 0.72, 0.79, 1)
Parameters = {"hold_seconds": 2.0}
