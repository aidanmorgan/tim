[resource]
script = ExtResource("1")
Id = "clutch"
Title = "Clutch"
Category = "Power"
Description = "Belt a drive into the left pulley and a machine to the right. Electricity closes the gold plates before drive passes through. Loss of electricity releases the coupling; the upstream motor can keep turning. Electricity alone cannot create shaft motion. Uses ideal shaft speeds, without torque, slip or freewheel inertia."
