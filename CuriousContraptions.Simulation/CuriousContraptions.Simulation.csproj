<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants Condition="'$(PlaytestDiagnostics)' == 'true'">$(DefineConstants);PLAYTEST</DefineConstants>
    <WasmMainJSPath>wwwroot/worker.js</WasmMainJSPath>
  </PropertyGroup>
  <!-- The shipped worker is the trimmed Publish bundle only: Build produces no bundle, and the publish carries
       no symbol map, source maps, debugger metadata or ICU shards. Every method is Mono AOT-compiled (LLVM, full AOT with no
       interpreter) to wasm-simd128 code with its IL stripped; WorkerAot.targets fails the publish unless that holds. -->
  <PropertyGroup>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <WasmBuildOnlyAfterPublish>true</WasmBuildOnlyAfterPublish>
    <RunAOTCompilation>true</RunAOTCompilation>
    <AOTMode>LLVMOnly</AOTMode>
    <WasmStripILAfterAOT>true</WasmStripILAfterAOT>
    <WasmEnableSIMD>true</WasmEnableSIMD>
    <WorkerAotRole>Worker</WorkerAotRole>
    <!-- The physics types whose compiled functions must contain f32x4 arithmetic (WorkerAot.targets check d). -->
    <WorkerAotSimdTypes>WorkshopPhysicsEngine;PrismaticConstraintSolver;SoftConstraint</WorkerAotSimdTypes>
    <InvariantGlobalization>true</InvariantGlobalization>
    <WasmEmitSymbolMap>false</WasmEmitSymbolMap>
    <WasmEmitSourceMap>false</WasmEmitSourceMap>
    <WasmDebugLevel>0</WasmDebugLevel>
    <DebuggerSupport>false</DebuggerSupport>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../content/puzzles.json" LogicalName="CuriousContraptions.Puzzles.json" />
    <ProjectReference Include="../CuriousContraptions.Animation/CuriousContraptions.Animation.csproj" />
    <ProjectReference Include="../CuriousContraptions.Abstractions/CuriousContraptions.Abstractions.csproj" />
    <Compile Include="../engine/gpu/*.cs" Exclude="../engine/gpu/BrowserWorkshopClient*.cs" Link="Gpu/%(Filename)%(Extension)" />
    <Compile Include="../engine/PartId.cs" Link="Engine/PartId.cs" />
    <Using Include="CuriousContraptions" />
    <WasmExtraFilesToDeploy Include="wwwroot/**" />
    <!-- worker.js reaches every [JSExport] entry point by name, so the trimmer keeps the whole worker assembly. -->
    <TrimmerRootAssembly Include="$(AssemblyName)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../CuriousContraptions.FlatBuffers/CuriousContraptions.FlatBuffers.csproj" />
    <!-- Story 9A.17: the worker reads its declared ports from the generated element bundle, the only declaration source. The
         bundle schema and validator are the ones the game loads with; building BundleElements generates the bundle (and fails
         on an invalid package) before it is embedded here. -->
    <ProjectReference Include="../CuriousContraptions.Bundle/CuriousContraptions.Bundle.csproj" />
    <ProjectReference Include="../tools/BundleElements/BundleElements.csproj" ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" />
    <EmbeddedResource Include="../elements/elements.bundle.json" LogicalName="elements.bundle.json" />
  </ItemGroup>
  <Import Project="../CuriousContraptions.web/WorkerAot.targets" />
  <!-- Return this project's actual trimmed publish bundle, never an assumed sibling output directory.
       The WebAssembly SDK writes the published bundle to $(OutputPath)AppBundle during Publish. -->
  <Target Name="GetWorkshopWorkerBundle" DependsOnTargets="Publish" Returns="@(_WorkshopWorkerBundleFiles)">
    <PropertyGroup>
      <_WorkshopWorkerBundleDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(OutputPath)', 'AppBundle'))</_WorkshopWorkerBundleDir>
    </PropertyGroup>
    <Error Condition="!Exists('$(_WorkshopWorkerBundleDir)worker.js')" Text="The current trimmed Workshop worker publish bundle is missing." />
    <ItemGroup>
      <_WorkshopWorkerBundleFiles Include="$(_WorkshopWorkerBundleDir)**/*" />
    </ItemGroup>
    <ItemGroup>
      <_WorkshopWorkerBundleFiles Update="@(_WorkshopWorkerBundleFiles)">
        <BundleRelativePath>%(_WorkshopWorkerBundleFiles.RecursiveDir)%(_WorkshopWorkerBundleFiles.Filename)%(_WorkshopWorkerBundleFiles.Extension)</BundleRelativePath>
      </_WorkshopWorkerBundleFiles>
    </ItemGroup>
    <Error Condition="'@(_WorkshopWorkerBundleFiles)' == ''" Text="The current Workshop worker bundle is empty." />
  </Target>
</Project>
