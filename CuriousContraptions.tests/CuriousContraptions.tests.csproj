<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <!-- Native tests always compile the real diagnostic recorder; no trace tests are conditionally omitted. -->
        <DefineConstants>$(DefineConstants);PLAYTEST</DefineConstants>
        <!-- Keep host namespaces uniform with the desktop host (whose
             '.2dog' assembly name is not a valid namespace). -->
        <RootNamespace>CuriousContraptions.Tests</RootNamespace>
    </PropertyGroup>

    <!-- 2dog packages (2dog.xunit pulls in 2dog.engine for the fixtures and ships the xUnit
         collection definitions as compile-in source) -->
    <ItemGroup>
        <PackageReference Include="2dog.xunit" Version="$(TwoDogVersion)" />
    </ItemGroup>

    <!-- Native library packages arrive transitively: 2dog pins the platform packages it was built against and
         their targets copy the native library -->

    <!-- Test framework packages -->
    <ItemGroup>
        <!-- Pinned exactly, and identically in tools/Coverage.Tests, so one solution run loads one xunit (Story 9.4b). -->
        <PackageReference Include="coverlet.collector" Version="10.1.0" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
        <PackageReference Include="xunit.v3" Version="3.2.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
        <Using Include="CuriousContraptions.Abstractions.PortId" Alias="PortId" />
        <Using Include="CuriousContraptions.Abstractions.PortRole" Alias="PortRole" />
    </ItemGroup>

    <!-- CSharpStaticGateTests parses every C# source with the SDK's own Roslyn (as tools/Ownership does). -->
    <ItemGroup>
        <Reference Include="Microsoft.CodeAnalysis"><HintPath>$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.dll</HintPath></Reference>
        <Reference Include="Microsoft.CodeAnalysis.CSharp"><HintPath>$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll</HintPath></Reference>
    </ItemGroup>

    <!-- CSharpStaticGateTests replays the gate builds' binary logs with the SDK's own MSBuild, which reads its format. -->
    <ItemGroup>
        <Reference Include="Microsoft.Build"><HintPath>$(MSBuildSDKsPath)/../Microsoft.Build.dll</HintPath></Reference>
        <Reference Include="Microsoft.Build.Framework"><HintPath>$(MSBuildSDKsPath)/../Microsoft.Build.Framework.dll</HintPath></Reference>
        <Reference Include="Microsoft.NET.StringTools"><HintPath>$(MSBuildSDKsPath)/../Microsoft.NET.StringTools.dll</HintPath></Reference>
    </ItemGroup>

    <ItemGroup>
        <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../CuriousContraptions.csproj" />
        <ProjectReference Include="../CuriousContraptions.Simulation/CuriousContraptions.Simulation.csproj" ReferenceOutputAssembly="false" />
        <ProjectReference Include="../CuriousContraptions.Animation.Worker/CuriousContraptions.Animation.Worker.csproj" ReferenceOutputAssembly="false" />
        <ProjectReference Include="../CuriousContraptions.Abstractions/CuriousContraptions.Abstractions.csproj" />
        <ProjectReference Include="../CuriousContraptions.FlatBuffers/CuriousContraptions.FlatBuffers.csproj" />
        <!-- PackageRuntimeParityTests discovers every element package through the generator, which references the package glob,
             and building the generator writes res://elements/elements.bundle.json, the only catalogue the registry loads
             (Story 9A.14), before these native tests read it. -->
        <ProjectReference Include="../tools/BundleElements/BundleElements.csproj" />
    </ItemGroup>

    <!-- One membership rule: every C# file directly in this directory is compiled (subdirectories are not), together
         with the two native-boundary sources linked from their host projects. A new test file needs no entry here. -->
    <ItemGroup>
        <Compile Include="../CuriousContraptions.Animation.Worker/RuntimeProviders.cs" Link="AnimationRuntimeProviders.cs" />
        <Compile Include="../CuriousContraptions.web/RuntimeProviders.cs" Link="WebRuntimeProviders.cs" />
        <Compile Include="*.cs" />
    </ItemGroup>

    <!-- Godot project location: the parent directory (hosts are nested inside
         the Godot project, hidden from the Godot editor by their .gdignore) -->
    <PropertyGroup>
        <GodotProjectDir>..</GodotProjectDir>
        <TwoDogVariant Condition="'$(Configuration)' == 'Debug'">debug</TwoDogVariant>
        <TwoDogVariant Condition="'$(Configuration)' == 'Editor'">editor</TwoDogVariant>
        <TwoDogRemoveDuplicateGodotAnalyzers>true</TwoDogRemoveDuplicateGodotAnalyzers>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Editor'">
        <DefineConstants>$(DefineConstants);EDITOR</DefineConstants>
    </PropertyGroup>

    <ItemGroup Condition="'$(Configuration)' == 'Editor'">
        <PackageReference Include="2dog.godotsharp.editor" Version="$(TwoDogVersion)" />
    </ItemGroup>
</Project>
