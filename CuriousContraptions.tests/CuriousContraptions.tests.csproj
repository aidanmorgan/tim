<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <DefineConstants Condition="'$(PlaytestDiagnostics)' == 'true'">$(DefineConstants);PLAYTEST</DefineConstants>
        <!-- Keep host namespaces uniform with the desktop host (whose
             '.2dog' assembly name is not a valid namespace). -->
        <RootNamespace>CuriousContraptions.Tests</RootNamespace>
    </PropertyGroup>

    <!-- 2dog packages (2dog.xunit pulls in 2dog.engine for the fixtures and ships the xUnit
         collection definitions as compile-in source) -->
    <ItemGroup>
        <PackageReference Include="2dog.xunit" Version="$(TwoDogVersion)"/>
    </ItemGroup>

    <!-- Native library packages arrive transitively: 2dog pins the platform packages it was built against and
         their targets copy the native library -->

    <!-- Test framework packages -->
    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="10.*"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.*"/>
        <PackageReference Include="xunit.v3" Version="3.*"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="3.*"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../CuriousContraptions.csproj"/>
    </ItemGroup>

    <!-- Explicit current test and native-boundary inputs; obsolete uncompiled tests were removed by Story 7.3. -->
    <ItemGroup>
        <Compile Include="CanonicalBodyTests.cs" />
        <Compile Include="RigidMassPropertiesTests.cs" />
        <Compile Include="WorkshopSimulationTests.cs" />
        <Compile Include="WorkshopSaveTests.cs" />
        <Compile Include="ContactActivationTests.cs" />
        <Compile Include="WorkshopActivationAnimationTests.cs" />
        <Compile Include="WorkshopWallTests.cs" />
        <Compile Include="WorkshopDelayTests.cs" />
        <Compile Include="WorkshopBumperTests.cs" />
        <Compile Include="WorkshopDominoTests.cs" />
        <Compile Include="WorkshopBowlingTests.cs" />
        <Compile Include="OrientationSensorTests.cs" />
        <Compile Include="DominoEffectTests.cs" />
        <Compile Include="WorkbenchCapacityTests.cs" />
        <Compile Include="DelayedSignalTests.cs" />
        <Compile Include="ActivationTimerTests.cs" />
        <Compile Include="WorkshopWireTests.cs" />
        <Compile Include="WorkshopReadTests.cs" />
        <Compile Include="NativeSceneFixture.cs" />
        <Compile Include="BasketballResourceTests.cs" />
        <Compile Include="WorkshopHintTests.cs" />
        <Compile Include="PortableAnimationTests.cs" />
        <Compile Include="WorkshopGpuDeviceTests.cs" />
        <Compile Include="WorkshopTraceTests.cs" />
        <Compile Include="WorkshopPoseRingTests.cs" />
        <Compile Include="WorkerAbiTests.cs" />
        <Compile Include="../CuriousContraptions.Simulation/WorkshopTrace.cs" Link="WorkshopTrace.cs" />
        <Compile Include="../CuriousContraptions.Simulation/WorkshopGpuDevice.cs" Link="WorkshopGpuDevice.cs" />
    </ItemGroup>

    <!-- Godot project location: the parent directory (hosts are nested inside
         the Godot project, hidden from the Godot editor by their .gdignore) -->
    <PropertyGroup>
        <GodotProjectDir>..</GodotProjectDir>
        <TwoDogVariant Condition="'$(Configuration)' == 'Debug'">debug</TwoDogVariant>
        <TwoDogVariant Condition="'$(Configuration)' == 'Editor'">editor</TwoDogVariant>
        <TwoDogRemoveDuplicateGodotAnalyzers>true</TwoDogRemoveDuplicateGodotAnalyzers>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Editor'">
        <DefineConstants>$(DefineConstants);EDITOR</DefineConstants>
    </PropertyGroup>

    <ItemGroup Condition="'$(Configuration)' == 'Editor'">
        <PackageReference Include="2dog.godotsharp.editor" Version="$(TwoDogVersion)" />
    </ItemGroup>
</Project>
