<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>CuriousContraptions.E2eRunner.Tests</RootNamespace>
  </PropertyGroup>
  <!-- The test framework packages pinned to exactly the versions CuriousContraptions.tests pins, so one
       `dotnet test CuriousContraptions.slnx` run discovers this project and loads one xunit (Story 9R.0a). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <Reference Include="Microsoft.CodeAnalysis"><HintPath>$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.dll</HintPath></Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp"><HintPath>$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll</HintPath></Reference>
    <ProjectReference Include="../E2eRunner/E2eRunner.csproj" />
    <!-- Build the shared runtime TS outputs used by the native node harnesses. -->
    <ProjectReference Include="../../CuriousContraptions.Abstractions/CuriousContraptions.Abstractions.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
