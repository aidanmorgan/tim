{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "playwright": ["/opt/homebrew/lib/node_modules/@playwright/mcp/node_modules/playwright"]
    }
  },
  "include": ["*.ts", "unit/*.ts"]
}
