<Project>
  <PropertyGroup>
    <RuntimeTypeScriptRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '../..'))</RuntimeTypeScriptRoot>
  </PropertyGroup>
  <ItemGroup>
    <RuntimeTypeScriptTool Include="$(RuntimeTypeScriptRoot)tools/workshop-console*.ts;$(RuntimeTypeScriptRoot)tools/workshop-close-findings*.ts" />
    <RuntimeTypeScriptHarness Include="$(RuntimeTypeScriptRoot)tools/runtime/**/*.ts" Exclude="$(RuntimeTypeScriptRoot)tools/runtime/**/*.d.ts" />
    <RuntimeTypeScriptSource Include="$(RuntimeTypeScriptRoot)CuriousContraptions.Animation.Worker/wwwroot/worker.ts;$(RuntimeTypeScriptRoot)CuriousContraptions.Simulation/wwwroot/clock-master.ts;$(RuntimeTypeScriptRoot)CuriousContraptions.web/wwwroot/clock-ring.ts;$(RuntimeTypeScriptRoot)CuriousContraptions.web/wwwroot/native-clock.ts;$(RuntimeTypeScriptRoot)CuriousContraptions.Simulation/wwwroot/worker.ts;$(RuntimeTypeScriptRoot)CuriousContraptions.web/wwwroot/event-ring-cursor.ts;$(RuntimeTypeScriptRoot)CuriousContraptions.web/wwwroot/workshop-client.ts;$(RuntimeTypeScriptRoot)tools/runtime/**/*.ts;$(RuntimeTypeScriptRoot)CuriousContraptions.web/wwwroot/pose-ring.ts;$(RuntimeTypeScriptRoot)CuriousContraptions.web/wwwroot/workshop-isolation.ts;$(RuntimeTypeScriptRoot)CuriousContraptions.web/wwwroot/workshop-isolation-worker.ts;$(RuntimeTypeScriptRoot)CuriousContraptions.web/wwwroot/workshop-bootstrap.ts" />
  </ItemGroup>
  <!-- Explicit entries exist at evaluation even when generated JS does not yet exist. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'CuriousContraptions.Simulation'">
    <WasmExtraFilesToDeploy Remove="wwwroot/worker.js;wwwroot/clock-master.js" />
    <WasmExtraFilesToDeploy Include="wwwroot/worker.js;wwwroot/clock-master.js" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'CuriousContraptions.web'">
    <WasmExtraFilesToDeploy Remove="wwwroot/event-ring-cursor.js;wwwroot/workshop-client.js;wwwroot/clock-ring.js;wwwroot/native-clock.js;wwwroot/pose-ring.js;wwwroot/workshop-isolation.js;wwwroot/workshop-isolation-worker.js;wwwroot/workshop-bootstrap.js" />
    <WasmExtraFilesToDeploy Include="wwwroot/event-ring-cursor.js;wwwroot/workshop-client.js;wwwroot/clock-ring.js;wwwroot/native-clock.js;wwwroot/pose-ring.js;wwwroot/workshop-isolation.js;wwwroot/workshop-isolation-worker.js;wwwroot/workshop-bootstrap.js" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'CuriousContraptions.Animation.Worker'">
    <WasmExtraFilesToDeploy Remove="wwwroot/worker.js" />
    <WasmExtraFilesToDeploy Include="wwwroot/worker.js" />
  </ItemGroup>
  <Target Name="RestoreRuntimeTypeScript" Condition="'$(MSBuildProjectName)' == 'CuriousContraptions.Abstractions'"
          Inputs="$(RuntimeTypeScriptRoot)package.json;$(RuntimeTypeScriptRoot)package-lock.json"
          Outputs="$(RuntimeTypeScriptRoot)node_modules/.package-lock.json">
    <Exec WorkingDirectory="$(RuntimeTypeScriptRoot)" Command="npm ci --ignore-scripts --no-audit --no-fund" />
  </Target>
  <!-- Abstractions is shared by native tests and both shipped hosts: one compiler invocation per build graph. -->
  <Target Name="BuildRuntimeTypeScript" BeforeTargets="BeforeBuild" DependsOnTargets="RestoreRuntimeTypeScript"
          Condition="'$(MSBuildProjectName)' == 'CuriousContraptions.Abstractions'"
          Inputs="@(RuntimeTypeScriptSource);@(RuntimeTypeScriptTool);$(RuntimeTypeScriptRoot)tsconfig.runtime.json;$(RuntimeTypeScriptRoot)package-lock.json;$(MSBuildThisFileFullPath)"
          Outputs="$(RuntimeTypeScriptRoot).runtime-build/CuriousContraptions.Animation.Worker/wwwroot/worker.js;$(RuntimeTypeScriptRoot).runtime-build/CuriousContraptions.Simulation/wwwroot/clock-master.js;$(RuntimeTypeScriptRoot).runtime-build/CuriousContraptions.Simulation/wwwroot/worker.js;$(RuntimeTypeScriptRoot).runtime-build/CuriousContraptions.web/wwwroot/clock-ring.js;$(RuntimeTypeScriptRoot).runtime-build/CuriousContraptions.web/wwwroot/native-clock.js;$(RuntimeTypeScriptRoot).runtime-build/CuriousContraptions.web/wwwroot/event-ring-cursor.js;$(RuntimeTypeScriptRoot).runtime-build/CuriousContraptions.web/wwwroot/workshop-client.js;$(RuntimeTypeScriptRoot).runtime-build/CuriousContraptions.web/wwwroot/pose-ring.js;$(RuntimeTypeScriptRoot).runtime-build/CuriousContraptions.web/wwwroot/workshop-isolation.js;$(RuntimeTypeScriptRoot).runtime-build/CuriousContraptions.web/wwwroot/workshop-isolation-worker.js;$(RuntimeTypeScriptRoot).runtime-build/CuriousContraptions.web/wwwroot/workshop-bootstrap.js;@(RuntimeTypeScriptTool->'$(RuntimeTypeScriptRoot).runtime-build/tools/%(Filename).js');$(RuntimeTypeScriptRoot)CuriousContraptions.web/wwwroot/pose-ring.js;$(RuntimeTypeScriptRoot)CuriousContraptions.web/wwwroot/workshop-isolation.js;$(RuntimeTypeScriptRoot)CuriousContraptions.web/wwwroot/workshop-isolation-worker.js;$(RuntimeTypeScriptRoot)CuriousContraptions.web/wwwroot/workshop-bootstrap.js;$(RuntimeTypeScriptRoot)CuriousContraptions.Animation.Worker/wwwroot/worker.js;$(RuntimeTypeScriptRoot)CuriousContraptions.Simulation/wwwroot/clock-master.js;$(RuntimeTypeScriptRoot)CuriousContraptions.web/wwwroot/clock-ring.js;$(RuntimeTypeScriptRoot)CuriousContraptions.web/wwwroot/native-clock.js;$(RuntimeTypeScriptRoot)CuriousContraptions.Simulation/wwwroot/worker.js;$(RuntimeTypeScriptRoot)CuriousContraptions.web/wwwroot/event-ring-cursor.js;$(RuntimeTypeScriptRoot)CuriousContraptions.web/wwwroot/workshop-client.js;@(RuntimeTypeScriptHarness->'$(RuntimeTypeScriptRoot).runtime-build/tools/runtime/%(RecursiveDir)%(Filename).js')">
    <Exec WorkingDirectory="$(RuntimeTypeScriptRoot)" Command="npm run build:runtime" />
    <Copy SourceFiles="$(RuntimeTypeScriptRoot).runtime-build/CuriousContraptions.Simulation/wwwroot/worker.js"
          DestinationFiles="$(RuntimeTypeScriptRoot)CuriousContraptions.Simulation/wwwroot/worker.js" />
    <Copy SourceFiles="$(RuntimeTypeScriptRoot).runtime-build/CuriousContraptions.web/wwwroot/event-ring-cursor.js"
          DestinationFiles="$(RuntimeTypeScriptRoot)CuriousContraptions.web/wwwroot/event-ring-cursor.js" />
    <Copy SourceFiles="$(RuntimeTypeScriptRoot).runtime-build/CuriousContraptions.web/wwwroot/workshop-client.js"
          DestinationFiles="$(RuntimeTypeScriptRoot)CuriousContraptions.web/wwwroot/workshop-client.js" />
    <Copy SourceFiles="$(RuntimeTypeScriptRoot).runtime-build/CuriousContraptions.Animation.Worker/wwwroot/worker.js" DestinationFiles="$(RuntimeTypeScriptRoot)CuriousContraptions.Animation.Worker/wwwroot/worker.js" />
    <Copy SourceFiles="$(RuntimeTypeScriptRoot).runtime-build/CuriousContraptions.Simulation/wwwroot/clock-master.js" DestinationFiles="$(RuntimeTypeScriptRoot)CuriousContraptions.Simulation/wwwroot/clock-master.js" />
    <Copy SourceFiles="$(RuntimeTypeScriptRoot).runtime-build/CuriousContraptions.web/wwwroot/clock-ring.js" DestinationFiles="$(RuntimeTypeScriptRoot)CuriousContraptions.web/wwwroot/clock-ring.js" />
    <Copy SourceFiles="$(RuntimeTypeScriptRoot).runtime-build/CuriousContraptions.web/wwwroot/native-clock.js" DestinationFiles="$(RuntimeTypeScriptRoot)CuriousContraptions.web/wwwroot/native-clock.js" />
    <Copy SourceFiles="$(RuntimeTypeScriptRoot).runtime-build/CuriousContraptions.web/wwwroot/pose-ring.js" DestinationFiles="$(RuntimeTypeScriptRoot)CuriousContraptions.web/wwwroot/pose-ring.js" />
    <Copy SourceFiles="$(RuntimeTypeScriptRoot).runtime-build/CuriousContraptions.web/wwwroot/workshop-isolation.js" DestinationFiles="$(RuntimeTypeScriptRoot)CuriousContraptions.web/wwwroot/workshop-isolation.js" />
    <Copy SourceFiles="$(RuntimeTypeScriptRoot).runtime-build/CuriousContraptions.web/wwwroot/workshop-isolation-worker.js" DestinationFiles="$(RuntimeTypeScriptRoot)CuriousContraptions.web/wwwroot/workshop-isolation-worker.js" />
    <Copy SourceFiles="$(RuntimeTypeScriptRoot).runtime-build/CuriousContraptions.web/wwwroot/workshop-bootstrap.js" DestinationFiles="$(RuntimeTypeScriptRoot)CuriousContraptions.web/wwwroot/workshop-bootstrap.js" />
    <ItemGroup>
      <FileWrites Include="$(RuntimeTypeScriptRoot)CuriousContraptions.web/wwwroot/pose-ring.js;$(RuntimeTypeScriptRoot)CuriousContraptions.web/wwwroot/workshop-isolation.js;$(RuntimeTypeScriptRoot)CuriousContraptions.web/wwwroot/workshop-isolation-worker.js;$(RuntimeTypeScriptRoot)CuriousContraptions.web/wwwroot/workshop-bootstrap.js;$(RuntimeTypeScriptRoot)CuriousContraptions.Animation.Worker/wwwroot/worker.js;$(RuntimeTypeScriptRoot)CuriousContraptions.Simulation/wwwroot/clock-master.js;$(RuntimeTypeScriptRoot)CuriousContraptions.web/wwwroot/clock-ring.js;$(RuntimeTypeScriptRoot)CuriousContraptions.web/wwwroot/native-clock.js;$(RuntimeTypeScriptRoot).runtime-build/**/*.js;$(RuntimeTypeScriptRoot)CuriousContraptions.Simulation/wwwroot/worker.js;$(RuntimeTypeScriptRoot)CuriousContraptions.web/wwwroot/event-ring-cursor.js;$(RuntimeTypeScriptRoot)CuriousContraptions.web/wwwroot/workshop-client.js" />
    </ItemGroup>
  </Target>
</Project>
