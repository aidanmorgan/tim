namespace CuriousContraptions.Wire;

enum SimulationPhase : uint8 {
    Uninitialized = 0,
    Initializing = 1,
    Building = 2,
    Admitting = 3,
    Starting = 4,
    Running = 5,
    Paused = 6,
    Completed = 7,
    Resetting = 8,
    Faulted = 9,
    Disposed = 10
}

enum CommandKind : uint32 {
    Initialize = 0,
    Construct = 1,
    Run = 2,
    Reset = 3,
    Dispose = 4,
    Cancel = 5,
    ConfigureCadence = 6,
    Pause = 7,
    Resume = 8,
    Step = 9,
    Save = 10,
    ConfigureElectrical = 11,
    // The stopped memory observation query (Story 9A.3): its acknowledgement carries WorkshopResponse.memory.
    ObserveMemory = 12
}

enum CommandOutcome : uint8 {
    Applied = 0,
    Rejected = 1,
    Superseded = 2,
    Faulted = 3,
    Cancelled = 4
}

enum ResponseKind : uint8 {
    Acknowledgement = 0,
    Read = 1
}

enum ElectricalEnable : uint8 {
    Disabled = 0,
    Enabled = 1
}

struct Vec3f {
    x: float;
    y: float;
    z: float;
}

struct Vec3i {
    x: int32;
    y: int32;
    z: int32;
}

struct Quat4f {
    x: float;
    y: float;
    z: float;
    w: float;
}

struct BodyRead {
    id: uint64;
    cell: Vec3i;
    local: Vec3f;
    rotation: Quat4f;
    com: Vec3f;
    velocity: Vec3f;
    angular_velocity: Vec3f;
}

struct CaptureLatchRead {
    sensor: uint64;
    target: uint64;
    phase: uint32;
    event_ordinal: uint32;
    event_phase: float;
}

struct ElectricalSourceRecord {
    id: uint64;
    owner: uint64;
    remaining: float;
    debit: float;
    enabled: uint8;
    available: bool;
}

struct ContactWorkStoreRecord {
    id: uint64;
    owner: uint64;
    occurrence_count: uint32;
    remaining_energy: float;
    supplied_energy: float;
}

struct ActivationRecord {
    node: uint64;
    owner: uint64;
    source: uint64;
    body: uint64;
    collider: uint64;
    phase: uint32;
    event_ordinal: uint32;
    event_phase: float;
    approach_speed: float;
    kind: uint32;
    emitter: uint64;
    cause_ordinal: uint32;
    cause_phase: float;
}

struct TimerRecord {
    node: uint64;
    phase: uint32;
    started_tick: uint64;
    due_tick: uint64;
    input_kind: uint32;
    input_ordinal: uint32;
    input_phase: float;
    input_approach_speed: float;
    input_emitter: uint64;
    cause_source: uint64;
    cause_body: uint64;
    cause_collider: uint64;
    cause_ordinal: uint32;
    cause_phase: float;
}

// Committed Counter / System Clock memory of one activation node (Story 9R.1 D3). kind is the ActivationNodeKind (Counter 6,
// Oscillator 7); count is the counter's count or the clock's pulse count; last_* is the counter's last counted input time;
// phase is the clock's OscillatorPhase (Stopped 0, Running 1) and due_tick its next pulse tick (0: none).
struct ActivationMemoryRecord {
    node: uint64;
    kind: uint32;
    count: uint32;
    last_ordinal: uint32;
    last_phase: float;
    phase: uint32;
    due_tick: uint64;
}

struct ElectricalLogicRecord {
    owner: uint64;
    inputs: uint8;
    supplied: bool;
    active: bool;
}

struct ActuatorDriveRecord {
    joint: uint64;
    owner: uint64;
    supply_closed: bool;
    // C-Gate: the moving body took a positive normal contact impulse from a body other than its base during the tick.
    moving_contact: bool;
    coordinate: float;
    speed: float;
    lower: float;
    upper: float;
}

struct ContactLoadRecord {
    sensor: uint64;
    frame: uint64;
    region: uint64;
    measured_mass: float;
    phase: uint32;
}

struct ClockStamp {
    time: int64;
    uncertainty: uint64;
    domain: uint8;
}

struct ElectricalControl {
    owner: uint64;
    enabled: uint8;
}



// One stopped collector measurement of the Simulation worker (Story 9A.3): managed usage before and after a full blocking
// collection, its duration in Stopwatch ticks at frequency, and the allocation and collection counters around it.
struct MemoryObservationRecord {
    used_before: int64;
    used_after: int64;
    duration_ticks: int64;
    frequency: int64;
    allocated_before: int64;
    allocated_after: int64;
    collections_before: int32;
    collections_after: int32;
}

struct CommandIdentityRecord {
    sequence: uint64;
    epoch: uint64;
    revision: uint64;
    cadence: uint64;
    projection: uint64;
}

table WorkshopResponse {
    sequence: uint64;
    kind: ResponseKind;
    outcome: CommandOutcome;
    reason: uint8;
    phase: SimulationPhase;
    epoch: uint64;
    tick: uint64;
    revision: uint64;
    publication: uint64;
    master_generation: uint64;
    cadence: uint64;
    projection: uint64;
    session: [uint8];
    capture: ClockStamp;
    bodies: [BodyRead];
    captures: [CaptureLatchRead];
    activations: [ActivationRecord];
    timers: [TimerRecord];
    // Story 9A.23 D9: the owners' stores only; each hit reaches consumers as its event ring Impact record.
    contact_works: [ContactWorkStoreRecord];
    electrical: [ElectricalSourceRecord];
    activation_memory: [ActivationMemoryRecord];
    // The committed render trajectory: the physics ABI's PhysicsMotionRead record, validated against this read's bodies and tick.
    motion: [uint8];
    // Present only on the acknowledgement of an applied memory query command.
    memory: MemoryObservationRecord;
    actuator_drives: [ActuatorDriveRecord];
    contact_loads: [ContactLoadRecord];
    electrical_logic: [ElectricalLogicRecord];
    // Present on installation: workers admit the same compiled capabilities.
    scene: CompiledSceneRecord;
}

table WorkshopCommand {
    sequence: uint64;
    kind: CommandKind;
    epoch: uint64;
    revision: uint64;
    revision_kind: uint32;
    session: [uint8];
    cadence: uint64;
    projection: uint64;
    electrical: ElectricalControl;
    target: CommandIdentityRecord;
    scene: CompiledSceneRecord;
}

// Every buffer is size-prefixed and carries its root's identifier (Story 9A.2): "CCWC" WorkshopCommand, "CCWR" WorkshopResponse
// (acknowledgements, physical reads and schedule endpoints) and "CCWS" SavedConstruction. A schema declares one file_identifier,
// so the codecs pass each root's identifier to FinishSizePrefixed and to the verifier. No field or check names a format generation.
// Concrete session diagnostic payloads, carried by the same verified codec ("CCWO").
// Existing clock/command/response/trace blobs below are decoded only by their managed codecs.
struct ObservationInterval { lower_low:uint64; lower_high:int64; upper_low:uint64; upper_high:int64; }
struct ObservationSlot { receipt:int64; sequence:uint64; interval:ObservationInterval; }
struct ObservationExchange { before:int64; master:int64; after:int64; epoch:uint32; }
table FaultObservation { kind:uint32; site:uint32; exception_type:string (required); detail:string (required); }
table ReplyObservation { probe:[uint8] (required); master_received:int64; master_sent:int64; received:int64; derivation:uint32; }
table RecalibrationObservation {
    peer:[uint8] (required); cause:uint32; count:uint64; state_before:uint32;
    has_derivation:bool; derivation:uint32; display_epoch:uint64; at:int64;
    recovery_started:int64; recovery_sends:int32; pending:[uint8]; reply:ReplyObservation; slots:[ObservationSlot] (required);
}
table RejectedClockObservation { role:uint32; count:uint64; length:int32; received:int64; detail:string (required); }
table LateRenewalObservation {
    role:uint32; count:uint64; lapse_age:int64; exchanges:int32; renewed_at:int64;
    retained:ObservationInterval; fresh:ObservationInterval; has_derivation:bool; derivation:uint32; display_epoch:uint64;
}
table WideOffsetObservation { offset:int64; admitted_lower:int64; admitted_upper:int64; declared_uncertainty:int64; count:uint64; }
table DerivationObservation {
    report:uint32; outcome:uint32; epoch:uint32; correction:int64; has_pending:bool; pending:int64;
    has_admitted:bool; admitted_lower:int64; admitted_upper:int64; exchange:ObservationExchange;
    qualified:int32; startup_attempts:int32; startup_outliers:int32; startup_inconclusive:int32; startup_unanswered:int32;
    checks:uint64; slews:uint64; rederivations:uint64; inconclusive:uint64; unanswered:uint64; check_retries:uint64;
}
table DeferralObservation { cause:uint32; count:uint64; }
table DebtObservation { tick:uint64; reason:uint32; oldest:uint64; age_milliseconds:int64; }
table TickFailureObservation { outcome:uint32; reason:uint32; fault:uint32; }
table TransferObservation { response:[uint8] (required); }
table TraceSampleObservation { record:[uint8] (required); }
table CaptureObservation {
    kind:uint32; stage:uint32; identity:uint64; epoch:uint64; cadence:uint32; physical:uint32; revision:uint64;
    end:uint32; status:uint32; expected_count:int32; count:int32; chunk:int32; chunks:int32; first:int32;
    scene:uint64 = null; session:[uint8] (required); samples:[TraceSampleObservation] (required); milliseconds:[double] (required);
}
enum ObservationPayload: uint8 { None, Fault, Recalibration, RejectedClock, LateRenewal, WideOffset, Derivation, Deferral, Debt, TickFailure, Transfer, Capture }
table DiagnosticObservation {
    kind:ObservationPayload;
    fault:FaultObservation; recalibration:RecalibrationObservation; rejected_clock:RejectedClockObservation;
    late_renewal:LateRenewalObservation; wide_offset:WideOffsetObservation; derivation:DerivationObservation;
    deferral:DeferralObservation; debt:DebtObservation; tick_failure:TickFailureObservation;
    transfer:TransferObservation; capture:CaptureObservation;
}
table WorkshopObservationBatch {
    session:[uint8] (required); role:uint32; records:[DiagnosticObservation] (required); incomplete:string;
}
table CapabilityRigidBodyDeclarationRecord {
    id: ulong;
    motion: uint;
    cell: CapabilityCellOriginRecord (required);
    local: CapabilityLocalPositionRecord (required);
    rotation: CapabilityCanonicalRotationRecord (required);
    velocity: CapabilityLinearVelocityRecord (required);
    angular_velocity: CapabilityAngularVelocityRecord (required);
    mass: float;
    gravity: CapabilityAccelerationVectorRecord (required);
    linear_drag: float;
    mass_properties: CapabilityRigidMassPropertiesRecord (required);
    payload: uint;
}

table CapabilityCellOriginRecord {
    x: int;
    y: int;
    z: int;
}

table CapabilityLocalPositionRecord {
    x: float;
    y: float;
    z: float;
}

table CapabilityCanonicalRotationRecord {
    x: float;
    y: float;
    z: float;
    w: float;
}

table CapabilityLinearVelocityRecord {
    x: float;
    y: float;
    z: float;
}

table CapabilityAngularVelocityRecord {
    x: float;
    y: float;
    z: float;
}

table CapabilityAccelerationVectorRecord {
    x: float;
    y: float;
    z: float;
}

table CapabilityRigidMassPropertiesRecord {
    local_centre_of_mass: CapabilityMetreVectorRecord (required);
    principal_frame: CapabilityCanonicalRotationRecord (required);
    x: float;
    y: float;
    z: float;
}

table CapabilityMetreVectorRecord {
    x: float;
    y: float;
    z: float;
}

table CapabilityColliderDeclarationRecord {
    id: ulong;
    body: ulong;
    material: ulong;
    shape: uint;
    pose: CapabilityRigidLocalPoseRecord (required);
    radius: float;
    half_extents: CapabilityMetreVectorRecord (required);
}

table CapabilityRigidLocalPoseRecord {
    translation: CapabilityMetreVectorRecord (required);
    rotation: CapabilityCanonicalRotationRecord (required);
}

table CapabilityContactMaterialDeclarationRecord {
    id: ulong;
    restitution: float;
    bounce_threshold: float;
    friction: float;
    rolling_resistance: float;
}

table CapabilityResidenceSensorDeclarationRecord {
    id: ulong;
    frame: ulong;
    targets: CapabilityBodyTargetSetRecord (required);
    pose: CapabilityRigidLocalPoseRecord (required);
    minimum: CapabilityMetreVectorRecord (required);
    maximum: CapabilityMetreVectorRecord (required);
    speed_limit: float;
    dwell: float;
    participation: uint;
}

table CapabilityBodyTargetSetRecord {
    kind: uint;
    body: ulong;
}

table CapabilityPlanarGuideDeclarationRecord {
    id: ulong;
    frame: ulong;
    targets: CapabilityBodyTargetSetRecord (required);
    pose: CapabilityRigidLocalPoseRecord (required);
    minimum: CapabilityMetreVectorRecord (required);
    maximum: CapabilityMetreVectorRecord (required);
    support_height: float;
    support_margin: float;
    maximum_acceleration: float;
}

table CapabilityContactTriggerDeclarationRecord {
    id: ulong;
    owner: ulong;
    targets: CapabilityBodyTargetSetRecord (required);
    threshold: float;
}

table CapabilityContactWorkDeclarationRecord {
    id: ulong;
    owner: ulong;
    targets: CapabilityBodyTargetSetRecord (required);
    target_speed: float;
    initial_energy: float;
    threshold: float;
    cooldown_physical_steps: uint;
}

table CapabilityOrientationSensorDeclarationRecord {
    id: ulong;
    body: ulong;
    initial: CapabilityCanonicalRotationRecord (required);
    threshold: float;
}

table CapabilityElectricalSourceDeclarationRecord {
    id: ulong;
    owner: ulong;
    capacity: float;
    maximum_power: float;
    initial_fraction: float;
    enabled: uint;
}

table CapabilityElectricalStorageBindingRecord {
    source: ulong;
    storage: ulong;
}

table CapabilityPrismaticConstraintDeclarationRecord {
    id: ulong;
    body_a: ulong;
    body_b: ulong;
    frame_a: CapabilityConstraintFrameRecord (required);
    frame_b: CapabilityConstraintFrameRecord (required);
    lower: float;
    upper: float;
    stiffness: float;
    damping: float;
    collision: uint;
}

table CapabilityConstraintFrameRecord {
    position: CapabilityVector3Record (required);
    rotation: CapabilityQuaternionRecord (required);
}

table CapabilityVector3Record {
    x: float;
    y: float;
    z: float;
}

table CapabilityQuaternionRecord {
    x: float;
    y: float;
    z: float;
    w: float;
}

table CapabilitySupplyNodeDeclarationRecord {
    owner: ulong;
    kind: uint;
    source: ulong;
    consumers: [ulong];
    operation: uint = null;
}

table CapabilitySupplyEdgeRecord {
    source: ulong;
    target: ulong;
    input: uint;
}

table CapabilityContactLoadSensorDeclarationRecord {
    id: ulong;
    frame: ulong;
    region: ulong;
    minimum_x: float;
    maximum_x: float;
    minimum_z: float;
    maximum_z: float;
    local_normal: CapabilityVector3Record (required);
    minimum_alignment: float;
    maximum_gap: float;
    minimum_mass: float;
    supporting_colliders: [ulong];
}

table CapabilityPrismaticDriveDeclarationRecord {
    joint: ulong;
    target: float;
    max_speed: float;
    stopping_acceleration: float;
    max_effort: float;
    max_power: float;
}

table CapabilityActivationNodeDeclarationRecord {
    id: ulong;
    owner: ulong;
    kind: uint;
    trigger: ulong;
    duration_ticks: uint;
    sensor: ulong;
    passage: ulong;
    target_count: uint;
    interval_ticks: uint;
    power_source: ulong;
    collider: ulong;
    contact_load: ulong;
    release_hold_ticks: uint;
    completion: uint;
    boundary: uint;
    elapsed_signal: uint;
}

table CapabilityActivationEdgeRecord {
    source: ulong;
    target: ulong;
    input: uint;
}

table CapabilityPassageSensorDeclarationRecord {
    id: ulong;
    frame: ulong;
    cell: CapabilityCellOriginRecord (required);
    local: CapabilityLocalPositionRecord (required);
    rotation: CapabilityCanonicalRotationRecord (required);
    radius: float;
    rearm_clearance: float;
}

table CapabilityPresentationBindingRecord {
    property: uint;
    driver: uint;
    from: float;
    to: float;
    curve: uint;
    duration: float;
    overlap: uint;
    threshold: float;
    phase: uint;
    response: float;
    intermediate: float = null;
    socket: uint = null;
    event: uint;
    event_magnitude: uint;
}

table CapabilityWorkshopCadenceSettingsRecord {
    simulation: uint;
    physical: uint;
    animation: uint;
    presentation: uint;
    presentation_rate: CapabilityPulseRateRecord (required);
}

table CapabilityPulseRateRecord {
    numerator: uint;
    denominator: uint;
}

table CompiledPresentationRecord {
    target: ulong;
    owner: ulong;
    binding: int;
    declaration: CapabilityPresentationBindingRecord (required);
    activation: CapabilityActivationNodeDeclarationRecord;
    source_capacity: float;
}

table CompiledSceneRecord {
    identity: ulong;
    revision: ulong;
    settings: CapabilityWorkshopCadenceSettingsRecord (required);
    document_low: ulong;
    document_high: ulong;
    next_identity: ulong;
    bodies: [CapabilityRigidBodyDeclarationRecord];
    colliders: [CapabilityColliderDeclarationRecord];
    materials: [CapabilityContactMaterialDeclarationRecord];
    sensors: [CapabilityResidenceSensorDeclarationRecord];
    guides: [CapabilityPlanarGuideDeclarationRecord];
    triggers: [CapabilityContactTriggerDeclarationRecord];
    contact_works: [CapabilityContactWorkDeclarationRecord];
    orientation_sensors: [CapabilityOrientationSensorDeclarationRecord];
    electrical_sources: [CapabilityElectricalSourceDeclarationRecord];
    electrical_bindings: [CapabilityElectricalStorageBindingRecord];
    prismatics: [CapabilityPrismaticConstraintDeclarationRecord];
    supply_nodes: [CapabilitySupplyNodeDeclarationRecord];
    supply_edges: [CapabilitySupplyEdgeRecord];
    contact_load_sensors: [CapabilityContactLoadSensorDeclarationRecord];
    prismatic_drives: [CapabilityPrismaticDriveDeclarationRecord];
    activation_nodes: [CapabilityActivationNodeDeclarationRecord];
    activation_edges: [CapabilityActivationEdgeRecord];
    passage_sensors: [CapabilityPassageSensorDeclarationRecord];
    activation_substeps: uint;
    contact_owners: [ulong];
    owners: [ulong];
    editable_sources: [ulong];
    presentation: [CompiledPresentationRecord];
}

root_type WorkshopResponse;

