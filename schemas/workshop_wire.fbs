namespace CuriousContraptions.Wire;

enum SimulationPhase : uint8 {
    Uninitialized = 0,
    Initializing = 1,
    Building = 2,
    Admitting = 3,
    Starting = 4,
    Running = 5,
    Paused = 6,
    Completed = 7,
    Resetting = 8,
    Faulted = 9,
    Disposed = 10
}

enum CommandKind : uint32 {
    Initialize = 0,
    Construct = 1,
    Run = 2,
    Reset = 3,
    Dispose = 4,
    Cancel = 5,
    ConfigureCadence = 6,
    Pause = 7,
    Resume = 8,
    Step = 9,
    Save = 10,
    ConfigureElectrical = 11,
    // The stopped memory observation query (Story 9A.3): its acknowledgement carries WorkshopResponse.memory.
    ObserveMemory = 12
}

enum CommandOutcome : uint8 {
    Applied = 0,
    Rejected = 1,
    Superseded = 2,
    Faulted = 3,
    Cancelled = 4
}

enum ResponseKind : uint8 {
    Acknowledgement = 0,
    Read = 1
}

enum ElectricalEnable : uint8 {
    Disabled = 0,
    Enabled = 1
}

struct Vec3f {
    x: float;
    y: float;
    z: float;
}

struct Vec3i {
    x: int32;
    y: int32;
    z: int32;
}

struct Quat4f {
    x: float;
    y: float;
    z: float;
    w: float;
}

struct BodyRead {
    id: uint64;
    cell: Vec3i;
    local: Vec3f;
    rotation: Quat4f;
    com: Vec3f;
    velocity: Vec3f;
    angular_velocity: Vec3f;
}

struct CaptureLatchRead {
    sensor: uint64;
    target: uint64;
    phase: uint32;
    event_ordinal: uint32;
    event_phase: float;
}

struct ElectricalSourceRecord {
    id: uint64;
    owner: uint64;
    remaining: float;
    debit: float;
    enabled: uint8;
    available: bool;
}

struct ContactWorkStoreRecord {
    id: uint64;
    owner: uint64;
    occurrence_count: uint32;
    remaining_energy: float;
    supplied_energy: float;
}

struct ActivationRecord {
    node: uint64;
    owner: uint64;
    source: uint64;
    body: uint64;
    collider: uint64;
    phase: uint32;
    event_ordinal: uint32;
    event_phase: float;
    approach_speed: float;
    kind: uint32;
    emitter: uint64;
    cause_ordinal: uint32;
    cause_phase: float;
}

struct TimerRecord {
    node: uint64;
    phase: uint32;
    started_tick: uint64;
    due_tick: uint64;
    input_kind: uint32;
    input_ordinal: uint32;
    input_phase: float;
    input_approach_speed: float;
    input_emitter: uint64;
    cause_source: uint64;
    cause_body: uint64;
    cause_collider: uint64;
    cause_ordinal: uint32;
    cause_phase: float;
}

// Committed Counter / System Clock memory of one activation node (Story 9R.1 D3). kind is the ActivationNodeKind (Counter 6,
// Oscillator 7); count is the counter's count or the clock's pulse count; last_* is the counter's last counted input time;
// phase is the clock's OscillatorPhase (Stopped 0, Running 1) and due_tick its next pulse tick (0: none).
struct ActivationMemoryRecord {
    node: uint64;
    kind: uint32;
    count: uint32;
    last_ordinal: uint32;
    last_phase: float;
    phase: uint32;
    due_tick: uint64;
}

struct ElectricalLogicRecord {
    owner: uint64;
    inputs: uint8;
    supplied: bool;
    active: bool;
}

struct ActuatorDriveRecord {
    joint: uint64;
    owner: uint64;
    supply_closed: bool;
    // C-Gate: the moving body took a positive normal contact impulse from a body other than its base during the tick.
    moving_contact: bool;
    coordinate: float;
    speed: float;
    lower: float;
    upper: float;
}

struct ContactLoadRecord {
    sensor: uint64;
    frame: uint64;
    region: uint64;
    measured_mass: float;
    phase: uint32;
}

struct ClockStamp {
    time: int64;
    uncertainty: uint64;
    domain: uint8;
}

struct ElectricalControl {
    owner: uint64;
    enabled: uint8;
}

struct CadenceSettingsRecord {
    simulation: uint32;
    physical: uint32;
    animation: uint32;
    presentation: uint32;
    presentation_rate_numerator: uint32;
    presentation_rate_denominator: uint32;
}

// One stopped collector measurement of the Simulation worker (Story 9A.3): managed usage before and after a full blocking
// collection, its duration in Stopwatch ticks at frequency, and the allocation and collection counters around it.
struct MemoryObservationRecord {
    used_before: int64;
    used_after: int64;
    duration_ticks: int64;
    frequency: int64;
    allocated_before: int64;
    allocated_after: int64;
    collections_before: int32;
    collections_after: int32;
}

struct CommandIdentityRecord {
    sequence: uint64;
    epoch: uint64;
    revision: uint64;
    cadence: uint64;
    projection: uint64;
}

struct ConnectionRecord {
    source: uint64;
    target: uint64;
    domain: uint32;
    from_socket: uint32;
    to_socket: uint32;
}

// One authored assistance knot (Story 9A.44): eleven f32 lanes. A puzzle record carries exactly nine, the forgiving, balanced
// and precise knots of its primary, target and placement profiles in that order.
struct AssistanceKnotRecord {
    precision: float;
    position_window: float;
    rotation_window_degrees: float;
    maximum_position_correction: float;
    maximum_rotation_correction_degrees: float;
    blend: float;
    capture_margin: float;
    capture_speed: float;
    capture_dwell: float;
    guide_acceleration: float;
    trigger_threshold: float;
}

table ParameterRecord {
    key: string (required);
    value: float;
}

table InstanceRecord {
    id: uint64;
    part_id: string;
    locked: bool;
    cell: Vec3i;
    local: Vec3f;
    rotation: Quat4f;

    // Pipe
    length: float;

    parameters: [ParameterRecord];
}

table PuzzleRecord {
    id: string (required);
    placement: uint32;
    precision: float;
    inventory_part: string;
    inventory_count: uint32;
    goal_kind: uint32;
    goal_body: uint64;
    goal_target: uint64;
    goal_delay: float;
    assistance: [AssistanceKnotRecord] (required);
}

table ConstructionRecord {
    revision: uint64;
    settings: CadenceSettingsRecord;
    puzzle: PuzzleRecord;
    instances: [InstanceRecord];
    connections: [ConnectionRecord];
}

table SavedConstruction {
    next_body_id: uint64;
    construction: ConstructionRecord;
}

table WorkshopResponse {
    sequence: uint64;
    kind: ResponseKind;
    outcome: CommandOutcome;
    reason: uint8;
    phase: SimulationPhase;
    epoch: uint64;
    tick: uint64;
    revision: uint64;
    publication: uint64;
    master_generation: uint64;
    cadence: uint64;
    projection: uint64;
    session: [uint8];
    capture: ClockStamp;
    bodies: [BodyRead];
    captures: [CaptureLatchRead];
    activations: [ActivationRecord];
    timers: [TimerRecord];
    // Story 9A.23 D9: the owners' stores only; each hit reaches consumers as its event ring Impact record.
    contact_works: [ContactWorkStoreRecord];
    electrical: [ElectricalSourceRecord];
    activation_memory: [ActivationMemoryRecord];
    // The committed render trajectory: the physics ABI's PhysicsMotionRead record, validated against this read's bodies and tick.
    motion: [uint8];
    // Present only on the acknowledgement of an applied memory query command.
    memory: MemoryObservationRecord;
    actuator_drives: [ActuatorDriveRecord];
    contact_loads: [ContactLoadRecord];
    electrical_logic: [ElectricalLogicRecord];
    // Present on an installation endpoint: Animation admits the same declared construction.
    construction: ConstructionRecord;
}

table WorkshopCommand {
    sequence: uint64;
    kind: CommandKind;
    epoch: uint64;
    revision: uint64;
    revision_kind: uint32;
    session: [uint8];
    cadence: uint64;
    projection: uint64;
    electrical: ElectricalControl;
    settings: CadenceSettingsRecord;
    target: CommandIdentityRecord;
    construction_record: ConstructionRecord;
}

// Every buffer is size-prefixed and carries its root's identifier (Story 9A.2): "CCWC" WorkshopCommand, "CCWR" WorkshopResponse
// (acknowledgements, physical reads and schedule endpoints) and "CCWS" SavedConstruction. A schema declares one file_identifier,
// so the codecs pass each root's identifier to FinishSizePrefixed and to the verifier. No field or check names a format generation.
root_type WorkshopResponse;

