    attachment_b: Vec3f;
    maximum_length: float;
    current_length: float;
    integrity: uint;
    state: uint;
    cut_span: ulong;
}

table RopeGuideReadRecord {
    guide: ulong;
    travel: float;
    angle: float;
}

// One compliant surface's committed deflection (Story 10.5): its frame body and the depth in metres of its deepest engaged sample.
table CompliantSurfaceReadRecord {
    frame: ulong;
    deflection: float;
}

table PrismaticRetentionReadRecord {
    id: ulong;
    owner: ulong;
    coordinate: ulong;
    mode: ubyte;
    phase: ubyte;
    compression: float;
    potential: float;
    accepted_elastic_energy: float;
    released_elastic_energy: float;
    winding_work: float;
    positive_winding_transfer: float;
    contact_work: float;
    gravity_work: float;
    request_result: ubyte = null;
}

table MechanicalTransmissionReadRecord {
    transmission: ulong;
    owner: ulong;
    closure: float;
    phase: uint;
}

table TensileSpanRecord {
    id: ulong;
    route: ulong;
    order: uint;
    body_a: ulong;
    local_a: Vec3f;
    body_b: ulong;
    local_b: Vec3f;
    maximum_length: float;
    complete: bool;
    guide_radius: float;
    guide_offset: Vec3f;
    guide: ulong;
}

// One compliant membrane on a static frame body (Story 10.5, CAT-065): footprint half extents, rest height and stroke in the
// frame, and the evaluated f32 tension (N/m) and damping ratio.
table CompliantSurfaceRecord {
    id: ulong;
    body: ulong;
    half_x: float;
    half_z: float;
    rest_height: float;
    max_stroke: float;
    tension: float;
    damping_ratio: float;
    arrival_depth: float;
}

// One rope guide sheave declaration on a rigid body (Story 9A.46a).
table CapabilityRopeGuideRecord {
    id: ulong;
    body: ulong;
    radius: float;
    offset: Vec3f;
}

// A typed generalized-coordinate relation (untimed or timed by electrical supply).
table MechanicalTransmissionRecord {
    id: ulong;
    driving_coordinate: ulong;
    driven_coordinate: ulong;
    driving_kind: ubyte;
    driven_kind: ubyte;
    constraint_kind: ubyte;
    ratio: float;
    close_seconds: float = 0.0;
    owner: ulong;
    retention: ulong;
    initial_retention_coordinate: float;
}

table DrivenSurfaceRecord {
    id: ulong;
    carrier: ulong;
    collider: ulong;
    face: ubyte;
    source: ulong;
    direction: Vec3f (required);
    travel_per_radian: float;
}

table MechanicalRimPresentationRecord {
    support: ulong;
    joint: ulong;
    coordinate_support: ulong;
    centre: CapabilityVector3Record (required);
    frame: CapabilityQuaternionRecord (required);
    radius: float;
    angle_per_coordinate: float;
}
table MechanicalLinkPresentationRecord {
    target: ulong;
    source: MechanicalRimPresentationRecord (required);
    target_rim: MechanicalRimPresentationRecord (required);
}
table CompiledSceneRecord {
    identity: ulong;
    revision: ulong;
    settings: CapabilityWorkshopCadenceSettingsRecord (required);
    document_low: ulong;
    document_high: ulong;
    next_identity: ulong;
    bodies: [CapabilityRigidBodyDeclarationRecord];
    colliders: [CapabilityColliderDeclarationRecord];
    materials: [CapabilityContactMaterialDeclarationRecord];
    sensors: [CapabilityResidenceSensorDeclarationRecord];
    guides: [CapabilityPlanarGuideDeclarationRecord];
    triggers: [CapabilityContactTriggerDeclarationRecord];
    contact_works: [CapabilityContactWorkDeclarationRecord];
    orientation_sensors: [CapabilityOrientationSensorDeclarationRecord];
    electrical_sources: [CapabilityElectricalSourceDeclarationRecord];
    electrical_bindings: [CapabilityElectricalStorageBindingRecord];
    prismatics: [CapabilityPrismaticConstraintDeclarationRecord];
    tensile_spans: [TensileSpanRecord];
    supply_nodes: [CapabilitySupplyNodeDeclarationRecord];
    supply_edges: [CapabilitySupplyEdgeRecord];
    contact_load_sensors: [CapabilityContactLoadSensorDeclarationRecord];
    prismatic_drives: [CapabilityPrismaticDriveDeclarationRecord];
    activation_nodes: [CapabilityActivationNodeDeclarationRecord];
    activation_edges: [CapabilityActivationEdgeRecord];
    passage_sensors: [CapabilityPassageSensorDeclarationRecord];
    activation_substeps: uint;
    signal_contacts: [SignalContactRecord];
    owners: [ulong];
    run_controls: [RunControlRecord];
    presentation: [CompiledPresentationRecord];
    revolutes: [CapabilityRevoluteConstraintDeclarationRecord];
    compliant_surfaces: [CompliantSurfaceRecord];
    revolute_drives: [CapabilityRevoluteDriveDeclarationRecord];
    rope_guides: [CapabilityRopeGuideRecord];
    transmissions: [MechanicalTransmissionRecord];
    driven_surfaces: [DrivenSurfaceRecord] (required);
    mechanical_links: [MechanicalLinkPresentationRecord] (required);
    energy_stores: [EnergyStoreDeclarationRecord] (required);
    chamber_regions: [ChamberRegionDeclarationRecord] (required);
    finite_work_actuators: [FiniteWorkActuatorDeclarationRecord] (required);
    gas_stores: [GasStoreDeclarationRecord] (required);
    gas_shapes: [GasShapeDeclarationRecord] (required);
    inventory_masses: [InventoryMassDeclarationRecord] (required);
    ambient_loads: [AmbientLoadDeclarationRecord] (required);
    integrity_observers: [IntegrityDeclarationRecord] (required);
    airflow_sources: [AirflowSourceDeclarationRecord] (required);
    airflow_receivers: [AirflowReceiverDeclarationRecord] (required);
    rotary_airflow_captures: [RotaryAirflowCaptureDeclarationRecord] (required);
    coordinate_travel_observers: [CoordinateTravelDeclarationRecord] (required);
}

struct AirflowReadRecord {
    id: ulong;
    owner: ulong;
    input: uint;
    availability: uint;
    flow_speed: float;
    power: float;
    work: float;
    jet_loss: float;
    commit_work: float;
    commit_loss: float;
}

struct AirflowSampleRecord { x: float; y: float; z: float; weight: float; }
struct CoordinateTravelReadRecord {
    id: ulong;
    owner: ulong;
    threshold: float;
    travel: float;
    phase: uint;
    ordinal: uint;
}
table CoordinateTravelDeclarationRecord {
    id: ulong;
    owner: ulong;
    coordinate: ulong;
    threshold: float;
}
table RotaryAirflowCaptureDeclarationRecord {
    id: ulong;
    owner: ulong;
    frame: ulong;
    coordinate: ulong;
    samples: [AirflowSampleRecord] (required);
    internal_occluders: [ulong] (required);
    maximum_pitch: float;
    response: float;
    cut_in_force: float;
    maximum_rate: float;
}
table AirflowSourceDeclarationRecord {
    id: ulong;
    owner: ulong;
    frame: ulong;
    origin: Vec3f (required);
    axis: Vec3f (required);
    reach: float;
    terminal_radius: float;
    flow_speed: float;
    maximum_force: float;
    maximum_power: float;
    pressure_scale: float;
    internal_occluders: [ulong] (required);
    input_kind: ubyte;
    store: ulong;
    electrical: ulong;
    coordinate: ulong;
    sense: float;
    connected: bool;
    enable: ulong;
    initially_enabled: bool;
}
table AirflowReceiverDeclarationRecord {
    id: ulong;
    owner: ulong;
    collider: ulong;
    sampling: ubyte;
    samples: [AirflowSampleRecord] (required);
}

struct GasStoreDeclarationRecord {
    id: uint64;
    body: uint64;
    gas_r: float;
    gas_cv: float;
    minimum_temperature: float;
    maximum_temperature: float;
    maximum_density: float;
    maximum_pressure: float;
    reference_mass: float;
    reference_volume: float;
    reference_energy: float;
    boundary_pressure: float;
    gauge_pressure: float;
    conductance: float;
}
struct GasShapeDeclarationRecord { store: uint64; collider: uint64; dry_radius: float; }
struct InventoryMassDeclarationRecord { body: uint64; dry_mass: float; }
struct AmbientLoadDeclarationRecord {
    body: uint64;
    inventory_store: uint64;
    acceleration_x: float;
    acceleration_y: float;
    acceleration_z: float;
    linear_drag: float;
}
struct IntegrityDeclarationRecord {
    id: uint64;
    collider: uint64;
    store: uint64;
    threshold: float;
    minimum_approach_speed: float;
}
struct GasStoreReadRecord {
    id: uint64;
    body: uint64;
    mass: float;
    volume: float;
    energy: float;
    outlet: uint32;
    enthalpy_out: float;
    boundary_work: float;
    elastic_released: float;
    momentum_x: float;
    momentum_y: float;
    momentum_z: float;
    kinetic_out: float;
    preparation_work: float;
    preparation_elastic: float;
}
struct IntegrityReadRecord { id: uint64; phase: uint32; ordinal: uint32; event_phase: float; }

struct CadenceSettingsRecord (authoring) {
    simulation: uint32;
    physical: uint32;
    animation: uint32;
    presentation: uint32;
    presentation_rate_numerator: uint32;
    presentation_rate_denominator: uint32;
}

struct ConnectionRecord (authoring) {
    source: uint64;
    target: uint64;
    domain: uint32;
    from_socket: uint32;
    to_socket: uint32;
    has_rope_length: bool;
    rope_length: float;
}

// One authored assistance knot (Story 9A.44): eleven f32 lanes. A puzzle record carries exactly nine, the forgiving, balanced
// and precise knots of its primary, target and placement profiles in that order.
struct AssistanceKnotRecord (authoring) {
    precision: float;
    position_window: float;
    rotation_window_degrees: float;
    maximum_position_correction: float;
    maximum_rotation_correction_degrees: float;
    blend: float;
    capture_margin: float;
    capture_speed: float;
    capture_dwell: float;
    guide_acceleration: float;
    trigger_threshold: float;
}

table ParameterRecord (authoring) {
    key: string (required);
    value: float;
}

table InstanceRecord (authoring) {
    id: uint64;
    part_id: string;
    locked: bool;
    cell: Vec3i;
    local: Vec3f;
    rotation: Quat4f;

    // Pipe

    parameters: [ParameterRecord];
}

struct IntegrityGoalRecord (authoring) {
    owner: uint64;
    observation: uint32;
}

table PuzzleRecord (authoring) {
    id: string (required);
    placement: uint32;
    precision: float;
    inventory_part: string;
    inventory_count: uint32;
    goal_kind: uint32;
    goal_body: uint64;
    goal_target: uint64;
    goal_delay: float;
    goal_source_node: string;
    goal_target_node: string;
    assistance: [AssistanceKnotRecord] (required);
    interaction_target: uint64;
    goal_integrity: IntegrityGoalRecord;
}

table ConstructionRecord (authoring) {
    revision: uint64;
    settings: CadenceSettingsRecord;
    puzzle: PuzzleRecord;
    instances: [InstanceRecord];
    connections: [ConnectionRecord];
    atmosphere: uint32 = null;
}

table SavedConstruction (authoring) {
    next_body_id: uint64;
    construction: ConstructionRecord;
}

root_type SavedConstruction;
file_identifier "CCWS";
