{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmitOnError": true,
    "rootDir": ".",
    "outDir": ".runtime-build",
    "lib": [
      "ES2022",
      "DOM",
      "ES2024.SharedMemory"
    ],
    "types": [
      "node"
    ],
    "rootDirs": [
      "CuriousContraptions.Simulation",
      "CuriousContraptions.web/wwwroot",
      "CuriousContraptions.Animation.Worker"
    ]
  },
  "include": [
    "CuriousContraptions.Simulation/wwwroot/worker.ts",
    "CuriousContraptions.web/wwwroot/event-ring-cursor.ts",
    "CuriousContraptions.web/wwwroot/workshop-client.ts",
    "tools/runtime/**/*.ts",
    "CuriousContraptions.Simulation/wwwroot/clock-master.ts",
    "CuriousContraptions.Animation.Worker/wwwroot/worker.ts",
    "CuriousContraptions.web/wwwroot/clock-ring.ts",
    "CuriousContraptions.web/wwwroot/native-clock.ts",
    "CuriousContraptions.web/wwwroot/pose-ring.ts",
    "CuriousContraptions.web/wwwroot/workshop-isolation.ts",
    "CuriousContraptions.web/wwwroot/workshop-isolation-worker.ts",
    "CuriousContraptions.web/wwwroot/workshop-bootstrap.ts",
    "tools/workshop-console.ts",
    "tools/workshop-console.test.ts",
    "tools/workshop-close-findings.ts",
    "tools/workshop-close-findings.test.ts"
  ]
}
